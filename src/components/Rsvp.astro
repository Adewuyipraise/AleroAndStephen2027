---
import { wedding } from '../data/wedding.js';
const { rsvp } = wedding;
const API = 'https://script.google.com/macros/s/AKfycbwOrvTMUoC_GMJRBTjije-8qd1TqiHd0NgcQuHTx_UVRKyA_dk0S1LKR9gr_ByZCC6w/exec';
---
<section id="rsvp" class="section">
  <div class="container">
    <p class="section-label">Join us</p>
    <h2 class="section-title">RSVP</h2>

    <div id="rsvp-loading" class="state">
      <p class="muted">Verifying your invitation…</p>
    </div>

    <div id="rsvp-closed" class="state" hidden>
      <h3 class="serif">RSVP is now closed.</h3>
      <p class="muted">
        Thank you to everyone who responded. If you have an urgent enquiry,
        please contact the couple directly.
      </p>
    </div>

    <div id="rsvp-locked" class="state" hidden>
      <h3 class="serif">This RSVP link is personal.</h3>
      <p class="muted">
        Please use the personalised link sent to you by the couple or the
        event planner. If you believe you received this in error, kindly
        contact the couple directly.
      </p>
    </div>

    <div id="rsvp-used" class="state" hidden>
      <h3 class="serif">Thank you — you've already responded.</h3>
      <p class="muted">Your RSVP has been received. We can't wait to celebrate with you.</p>
    </div>

    <div id="rsvp-form-wrap" class="state" hidden>
      <p class="muted">
        Dear <strong id="guest-name">guest</strong>, kindly respond by
        <strong>{rsvp.closeDate}</strong>.
      </p>

      <div id="invited-events" class="invited-events" hidden>
        <p class="invited-label">You are invited to:</p>
        <ul id="event-list"></ul>
      </div>

      <form class="rsvp-form" id="rsvp-form">
        <input type="hidden" name="token" id="token-field" />

        <div class="row">
          <label>Your full name (as on your invitation)
            <input name="name" id="name-field" required />
          </label>
          <label>Email
            <input name="email" type="email" required />
          </label>
        </div>

        <div class="row">
          <label>Phone (WhatsApp)
            <input name="phone" />
          </label>
          <label>Will you be attending?
            <select name="attending" required>
              <option value="">Select…</option>
              <option>Yes, I'll be there</option>
              <option>No, sending love from afar</option>
            </select>
          </label>
        </div>

        <div class="row">
          <label>Bringing a +1?
            <select name="plusOne" id="plus-one-field">
              <option>No</option>
              <option>Yes — 1 guest</option>
            </select>
          </label>
          <label>Children under 11 attending?
            <input name="children" type="number" min="0" max="10" value="0" />
          </label>
        </div>

        <label class="full" id="plus-one-name-label" hidden>
          Your +1's full name
          <input name="plusOneName" id="plus-one-name" />
        </label>

        <label class="full">Message to the couple (optional)
          <textarea name="message" rows="3"></textarea>
        </label>

        <button type="submit" class="btn" id="submit-btn">Send RSVP</button>
        <p class="note muted">
          A +1 maximum. Children under 11 are exempt.
        </p>
        <p class="error" id="form-error" hidden></p>
      </form>
    </div>

    <div id="rsvp-done" class="state" hidden>
      <h3 class="serif">Thank you!</h3>
      <p class="muted">Your RSVP has been received. We can't wait to celebrate with you.</p>
    </div>
  </div>
</section>

<style>
  .state { max-width: 640px; }
  .rsvp-form {
    display: grid;
    gap: 18px;
    margin-top: 26px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: var(--shadow-sm);
  }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label {
    display: flex; flex-direction: column; gap: 7px;
    font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
  }
  input, select, textarea {
    font-family: inherit; font-size: 15px; padding: 13px 15px;
    border: 1px solid var(--line); background: var(--cream); color: var(--ink);
    text-transform: none; letter-spacing: normal;
    border-radius: 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  input:hover, select:hover, textarea:hover { border-color: #d5cbb8; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(168, 146, 116, 0.18);
  }
  textarea { resize: vertical; }
  .full { grid-column: 1 / -1; }
  .note { font-size: 13px; margin-top: 4px; }
  .error { color: #b3261e; font-size: 14px; margin-top: 8px; }

  .invited-events {
    margin: 24px 0 8px;
    padding: 22px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .invited-label {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 11px;
    color: var(--gold);
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .invited-label::before {
    content: '';
    width: 20px;
    height: 1px;
    background: var(--gold);
    flex: none;
  }
  .invited-events ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .invited-events li {
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .invited-events li:last-child { border-bottom: none; }

  /* Locked / done states as cards */
  .state h3 { font-size: 27px; margin: 0 0 10px; }

  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
    .rsvp-form { padding: 24px 20px; }
  }
</style>

<script define:vars={{ API, TIERS: wedding.eventsByTier }}>
  const params = new URLSearchParams(location.search);
  const token = (params.get('invite') || '').toUpperCase().trim();

  const $ = (id) => document.getElementById(id);
  const show = (id) => {
    ['rsvp-loading','rsvp-locked','rsvp-used','rsvp-closed','rsvp-form-wrap','rsvp-done']
      .forEach(s => $(s).hidden = s !== id);
  };

  window.__inviteToken = token;
  window.__guestType = 'General';

  const plusOneSelect = $('plus-one-field');
  const plusOneNameLabel = $('plus-one-name-label');
  plusOneSelect.addEventListener('change', () => {
    const yes = plusOneSelect.value.startsWith('Yes');
    plusOneNameLabel.hidden = !yes;
    $('plus-one-name').required = yes;
    if (yes) $('plus-one-name').focus();
  });

  function formatEventList(events) {
    return events.map(e => `${e.event} — ${e.date} · ${e.venue}`);
  }

  async function init() {
    if (!token) { show('rsvp-locked'); return; }

    try {
      const res = await fetch(`${API}?action=validate&token=${encodeURIComponent(token)}`);
      const data = await res.json();

      if (!data.valid) {
        show(data.reason === 'already_used' ? 'rsvp-used' : 'rsvp-locked');
        return;
      }

      const guestType = data.guestType === 'Special' ? 'Special' : 'General';
      window.__guestType = guestType;

      $('token-field').value = token;
      $('guest-name').textContent = data.expectedName || 'guest';
      $('name-field').value = data.expectedName || '';

      const events = TIERS[guestType] || TIERS.General;
      $('event-list').innerHTML = formatEventList(events).map(e => `<li>${e}</li>`).join('');
      $('invited-events').hidden = false;

      // Let Details.astro know
      window.dispatchEvent(new CustomEvent('guest-type-resolved', { detail: { guestType } }));

      show('rsvp-form-wrap');
    } catch {
      show('rsvp-locked');
    }
  }

  $('rsvp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('submit-btn');
    const errEl = $('form-error');
    errEl.hidden = true;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const payload = Object.fromEntries(new FormData(e.target).entries());
    payload.guestType = window.__guestType;

    try {
        const url = new URL(API);
        url.searchParams.set('action', 'rsvp');
        Object.entries(payload).forEach(([k, v]) => {
          if (v !== undefined && v !== null) url.searchParams.set(k, String(v));
        });

        const res = await fetch(url.toString(), { method: 'GET' });
        const data = await res.json();

      if (data.ok) {
        show('rsvp-done');
      } else if (data.error === 'name_mismatch') {
        errEl.textContent = 'The name you entered does not match your invitation. Please enter your full name exactly as it was sent to you.';
        errEl.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Send RSVP';
      } else {
        errEl.textContent = 'Something went wrong: ' + data.error;
        errEl.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Send RSVP';
      }
    } catch (err) {
      errEl.textContent = 'Connection error. Please try again or contact the couple.';
      errEl.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Send RSVP';
    }
  });

  const RSVP_DEADLINE = new Date('2027-04-04T23:59:59+01:00');
  if (new Date() > RSVP_DEADLINE) {
    show('rsvp-closed');
    return;
  }

  init();
</script>