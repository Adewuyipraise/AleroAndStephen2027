---
const {
  id,                 // section anchor id, e.g. "registry"
  label,              // small gold kicker, e.g. "With love"
  title,              // big serif title, e.g. "Registry"
  summaryTitle,       // collapsed heading, e.g. "Send a gift"
  summaryText,        // collapsed paragraph
  buttonText = 'Open', // button label
  containerClass = '', // optional extra class on .container
} = Astro.props;
---
<section id={id} class="section">
  <div class={`container ${containerClass}`}>
    <p class="section-label">{label}</p>
    <h2 class="section-title">{title}</h2>

    <!-- COLLAPSED SUMMARY -->
    <div class="collapse-summary" id={`${id}-summary`}>
      <div class="summary-inner">
        <h3 class="serif summary-title">{summaryTitle}</h3>
        <p class="muted summary-text">{summaryText}</p>
        <button class="btn open-btn" id={`${id}-open`} type="button">
          {buttonText}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:8px;vertical-align:-2px;" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- EXPANDED CONTENT -->
    <div class="collapse-full" id={`${id}-full`} hidden>
      <div class="collapse-bar">
        <p class="collapse-kicker">{title}</p>
        <button class="close-btn" id={`${id}-close`} type="button">
          Close ×
        </button>
      </div>

      <slot />
    </div>
  </div>
</section>

<style>
  [hidden] { display: none !important; }

  .collapse-summary {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 48px 32px;
    text-align: center;
    margin-top: 8px;
    box-shadow: 0 24px 60px -40px rgba(30, 30, 28, 0.5);
  }
  .summary-inner { max-width: 560px; margin: 0 auto; }
  .summary-title {
    font-size: 28px;
    margin: 0 0 10px;
    font-style: italic;
  }
  .summary-text {
    margin: 0 0 26px;
    font-size: 15px;
    line-height: 1.6;
  }
  .open-btn {
    display: inline-flex;
    align-items: center;
    padding: 15px 32px;
    border-radius: 999px;
  }

  .collapse-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .collapse-kicker {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 10.5px;
    color: var(--gold);
    margin: 0;
    font-weight: 500;
  }
  .close-btn {
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    padding: 8px 16px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s, border-color 0.2s;
  }
  .close-btn:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 560px) {
    .collapse-summary { padding: 36px 24px; }
  }
</style>

<script>
  // Universal collapse/expand — works for every CollapsibleSection
  function wireCollapse(id) {
    const summary = document.getElementById(`${id}-summary`);
    const full = document.getElementById(`${id}-full`);
    const openBtn = document.getElementById(`${id}-open`);
    const closeBtn = document.getElementById(`${id}-close`);
    const section = document.getElementById(id);

    if (!summary || !full || !openBtn || !closeBtn) return;

    openBtn.addEventListener('click', () => {
      summary.hidden = true;
      full.hidden = false;
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    closeBtn.addEventListener('click', () => {
      full.hidden = true;
      summary.hidden = false;
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  document.querySelectorAll('section[id]').forEach(section => {
    if (document.getElementById(`${section.id}-summary`)) {
      wireCollapse(section.id);
    }
  });
</script>