---
import { wedding } from '../data/wedding.js';
const { story } = wedding;
---
<section id="story" class="section">
  <div class="container">
    <p class="section-label">Our story</p>
    <h2 class="section-title">How we got here</h2>

    <div class="tabs" role="tablist" aria-label="Choose a viewpoint">
      <button class="tab active" data-tab="alero" role="tab" aria-selected="true" aria-controls="panel-alero" id="tab-alero">Alero's POV</button>
      <button class="tab" data-tab="stephen" role="tab" aria-selected="false" aria-controls="panel-stephen" id="tab-stephen">Stephen's POV</button>
    </div>

    <div class="panel active" data-panel="alero" role="tabpanel" id="panel-alero" aria-labelledby="tab-alero">
      <p class="year">2023</p>
      <h3>{story.alero.title}</h3>
      {story.alero.paragraphs.map(p => <p>{p}</p>)}
    </div>

    <div class="panel" data-panel="stephen" role="tabpanel" id="panel-stephen" aria-labelledby="tab-stephen" hidden>
      <p class="year">2023</p>
      <h3>{story.stephen.title}</h3>
      {story.stephen.paragraphs.map(p => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .tabs {
    display: inline-flex;
    gap: 4px;
    margin-bottom: 36px;
    padding: 5px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }
  .tab {
    background: none;
    border: none;
    padding: 11px 24px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    color: var(--muted);
    cursor: pointer;
    border-radius: 999px;
    transition: background 0.25s, color 0.25s, box-shadow 0.25s;
    white-space: nowrap;
  }
  .tab:hover { color: var(--ink); }
  .tab.active {
    background: var(--ink);
    color: var(--cream);
    box-shadow: 0 8px 18px -12px rgba(30, 30, 28, 0.9);
  }
  .tab:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  .panel {
    display: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px 44px;
    box-shadow: var(--shadow-sm);
    animation: panel-in 0.4s ease;
  }
  .panel[hidden] { display: none !important; }
  .panel.active { display: block; }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .year {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    color: var(--gold);
    margin: 0 0 4px;
    line-height: 1;
  }
  .panel h3 { font-size: 27px; margin: 0 0 20px; font-style: italic; }
  .panel p:not(.year) {
    font-size: 16px;
    margin: 0 0 18px;
    color: #3a3733;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .panel p:last-child { margin-bottom: 0; }

  @media (max-width: 560px) {
    .panel { padding: 28px 22px; }
    .tab { padding: 10px 16px; font-size: 16px; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll('.tab'));
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab;
      tabs.forEach(b => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      document.querySelectorAll('.panel').forEach(p => {
        const on = p.dataset.panel === id;
        p.classList.toggle('active', on);
        p.hidden = !on;
      });
    });
  });
</script>
