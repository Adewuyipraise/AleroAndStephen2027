</style>

<style is:global>
  /* ---- Dynamic elements (created by JS below) must not be Astro-scoped ---- */
  #registry [hidden] { display: none !important; }

  @keyframes giftIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes rowIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes popBadge {
    0% { transform: scale(0); opacity: 0; }
    70% { transform: scale(1.25); }
    100% { transform: scale(1); opacity: 1; }
  }

  #gift-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }
  @media (max-width: 560px) {
    #gift-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  }

  .gift-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    animation: giftIn 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
  }
  .gift-card:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: 0 26px 46px -24px rgba(30, 30, 28, 0.45);
  }
  .gift-card:focus-visible {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(168, 146, 116, 0.28);
  }
  .gift-card.in-cart {
    border-color: transparent;
    box-shadow: 0 0 0 1.5px var(--gold), 0 26px 46px -26px rgba(168, 146, 116, 0.75);
  }

  .gift-media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: linear-gradient(135deg, #f4f0e8, #ebe4d6);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gift-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .gift-card:hover .gift-media img { transform: scale(1.07); }
  .gift-media .gift-media-fallback { display: none; font-size: 52px; line-height: 1; }
  .gift-media.no-img .gift-media-fallback { display: block; }

  .gift-check {
    position: absolute;
    top: 11px;
    right: 11px;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: var(--gold);
    color: #fff;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0);
    box-shadow: 0 6px 16px -6px rgba(168, 146, 116, 0.9);
    z-index: 1;
  }
  .gift-card.in-cart .gift-check { animation: popBadge 0.35s cubic-bezier(0.2, 0.7, 0.3, 1) forwards; }

  .gift-body { padding: 15px 16px 4px; }
  .gift-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 19px;
    line-height: 1.2;
    margin: 0 0 5px;
    color: var(--ink);
  }
  .gift-price {
    font-size: 15px;
    font-weight: 500;
    color: var(--gold);
    margin: 0;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .gift-foot { margin-top: auto; padding: 13px 16px 16px; }

  .gift-add-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 11px 16px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-family: inherit;
    background: #fff;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.15s;
  }
  .gift-add-btn:hover { background: var(--ink); color: var(--cream); }
  .gift-add-btn:active { transform: scale(0.97); }
  .gift-card.in-cart .gift-add-btn { display: none; }

  .gift-stepper {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 5px;
    background: #fdfaf3;
    border: 1px solid var(--gold);
    border-radius: 999px;
  }
  .gift-card.in-cart .gift-stepper { display: flex; }
  .gift-stepper button {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    font-size: 17px;
    line-height: 1;
    font-family: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.12s;
  }
  .gift-stepper button:hover { background: var(--gold); border-color: var(--gold); color: #fff; }
  .gift-stepper button:active { transform: scale(0.9); }
  .gift-stepper .gift-stepper-qty {
    min-width: 28px;
    text-align: center;
    font-weight: 600;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-card, .gift-card .gift-media img, .gift-check { animation: none !important; transition: none !important; }
    .gift-card.in-cart .gift-check { opacity: 1; transform: scale(1); }
  }

  /* ---------------- Cart rows ---------------- */
  .cart-items { list-style: none; padding: 0; margin: 8px 0 0; }
  .cart-items:empty { margin: 0; }
  .cart-items li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px dashed var(--line);
    animation: rowIn 0.28s ease both;
  }
  .cart-items li:last-child { border-bottom: none; }

  .cart-thumb {
    width: 48px;
    height: 48px;
    border-radius: 13px;
    object-fit: cover;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cart-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .cart-item-info { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .cart-item-name {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cart-item-sub {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .cart-item-ctrl { display: flex; align-items: center; gap: 8px; }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
  }
  .qty-btn {
    width: 27px;
    height: 27px;
    border-radius: 50%;
    border: none;
    background: #fff;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    font-family: inherit;
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(30, 30, 28, 0.12);
    transition: background 0.15s, color 0.15s, transform 0.12s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .qty-btn:hover { background: var(--ink); color: var(--cream); }
  .qty-btn:active { transform: scale(0.88); }
  .qty-value {
    min-width: 20px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .remove-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #b8b1a5;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
    padding: 0;
  }
  .remove-btn:hover { background: #fbeae9; color: #b3261e; }

  @media (max-width: 420px) {
    .cart-items li { grid-template-columns: 44px minmax(0, 1fr); }
    .cart-item-ctrl { grid-column: 1 / -1; justify-content: flex-end; }
  }
</style>

<script define:vars={{ API, GIFTS: gifts }}>
  const $ = (id) => document.getElementById(id);
  let cart = {}; // { itemId: qty }

  const money = (n) => `₦${Number(n).toLocaleString()}`;

  // ---------- Toast ----------
  let toastTimer;
  function showToast(msg) {
    const t = $('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
  }

  function pulseCount() {
    const c = $('cart-count');
    c.classList.remove('pulse');
    void c.offsetWidth;
    c.classList.add('pulse');
    setTimeout(() => c.classList.remove('pulse'), 450);
  }

  // ---------- Gift grid ----------
  function renderGiftGrid() {
    const grid = $('gift-grid');
    grid.innerHTML = GIFTS.items.map((item, i) => `
      <div class="gift-card" data-id="${item.id}" style="--d:${i * 70}ms">
        <div class="gift-media${item.image ? '' : ' no-img'}">
          ${item.image ? `<img src="${item.image}" alt="${item.name}" loading="lazy"
               onerror="this.closest('.gift-media').classList.add('no-img');this.remove();" />` : ''}
          <span class="gift-media-fallback" aria-hidden="true">${item.emoji || '🎁'}</span>
          <span class="gift-check" aria-hidden="true">✓</span>
        </div>
        <div class="gift-body">
          <p class="gift-name">${item.name}</p>
          <p class="gift-price">${money(item.price)}</p>
        </div>
        <div class="gift-foot">
          <button type="button" class="gift-add-btn" data-add="${item.id}"
                  aria-label="Add ${item.name} to basket">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Add to basket
          </button>
          <div class="gift-stepper">
            <button type="button" data-act="dec" aria-label="Decrease quantity of ${item.name}">−</button>
            <span class="gift-stepper-qty" aria-live="polite">1</span>
            <button type="button" data-act="inc" aria-label="Increase quantity of ${item.name}">+</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function changeQty(id, delta) {
    const item = GIFTS.items.find(i => i.id === id);
    if (!item) return;
    const next = (cart[id] || 0) + delta;

    if (next <= 0) {
      if (cart[id]) {
        delete cart[id];
        showToast(`Removed ${item.name}`);
      }
    } else {
      cart[id] = next;
    }
    renderCart();
  }

  function addItem(id) {
    const item = GIFTS.items.find(i => i.id === id);
    if (!item) return;
    cart[id] = (cart[id] || 0) + 1;
    showToast(`Added ${item.name} to basket`);
    renderCart();
    pulseCount();

    const card = document.querySelector(`.gift-card[data-id="${id}"]`);
    if (card) {
      card.animate(
        [
          { transform: 'translateY(-6px) scale(1)' },
          { transform: 'translateY(-10px) scale(1.025)' },
          { transform: 'translateY(-6px) scale(1)' },
        ],
        { duration: 340, easing: 'ease-out' }
      );
    }
  }

  // Delegated — survives every re-render of the grid
  $('gift-grid').addEventListener('click', (e) => {
    const step = e.target.closest('.gift-stepper button');
    if (step) {
      e.stopPropagation();
      changeQty(step.closest('.gift-card').dataset.id, step.dataset.act === 'inc' ? 1 : -1);
      return;
    }
    const card = e.target.closest('.gift-card');
    if (card) addItem(card.dataset.id);
  });

  // ---------- Cart render ----------
  function renderCart() {
    const list = $('cart-items');
    const empty = $('cart-empty');
    const totalWrap = $('cart-total-wrap');

    const entries = Object.entries(cart);

    // Sync gift cards
    document.querySelectorAll('.gift-card').forEach(card => {
      const qty = cart[card.dataset.id] || 0;
      card.classList.toggle('in-cart', qty > 0);
      card.querySelector('.gift-stepper-qty').textContent = qty || 1;
    });

    if (entries.length === 0) {
      empty.hidden = false;
      list.innerHTML = '';
      totalWrap.hidden = true;
      updateGrandTotal();
      return;
    }

    empty.hidden = true;
    totalWrap.hidden = false;

    let subtotal = 0;
    list.innerHTML = entries.map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      if (!item) return '';
      const line = item.price * qty;
      subtotal += line;
      const thumb = item.image
        ? `<img src="${item.image}" alt="" loading="lazy" />`
        : `<span>${item.emoji || '🎁'}</span>`;
      return `
        <li data-id="${id}">
          <div class="cart-thumb">${thumb}</div>
          <div class="cart-item-info">
            <span class="cart-item-name">${item.name}</span>
            <span class="cart-item-sub">${money(item.price)} × ${qty} = ${money(line)}</span>
          </div>
          <div class="cart-item-ctrl">
            <div class="qty-controls">
              <button type="button" class="qty-btn" data-act="dec" aria-label="Decrease">−</button>
              <span class="qty-value">${qty}</span>
              <button type="button" class="qty-btn" data-act="inc" aria-label="Increase">+</button>
            </div>
            <button type="button" class="remove-btn" data-act="rm" aria-label="Remove ${item.name}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </li>
      `;
    }).join('');

    $('cart-total').textContent = money(subtotal);
    updateGrandTotal();
  }

  // Delegated — survives every re-render of the list
  $('cart-items').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const id = btn.closest('li').dataset.id;
    const act = btn.dataset.act;
    if (act === 'rm') {
      const item = GIFTS.items.find(i => i.id === id);
      delete cart[id];
      if (item) showToast(`Removed ${item.name}`);
      renderCart();
      return;
    }
    changeQty(id, act === 'inc' ? 1 : -1);
  });

  function cartCount() {
    return Object.values(cart).reduce((sum, qty) => sum + qty, 0);
  }

  function grandTotalValue() {
    const itemsTotal = Object.entries(cart).reduce((sum, [id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return sum + (item ? item.price * qty : 0);
    }, 0);
    return itemsTotal + Math.max(0, Number($('custom-amount').value || 0));
  }

  function updateGrandTotal() {
    const total = grandTotalValue();
    const count = cartCount();

    $('grand-total').textContent = money(total);
    $('cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;

    // Clear-basket affordance
    $('clear-cart').hidden = count === 0;

    // Minimum-contribution progress
    const min = GIFTS.minCustom;
    const bar = $('min-progress');
    const fill = $('min-progress-fill');
    const text = $('min-progress-text');
    const pct = Math.min(100, Math.round((total / min) * 100));
    bar.hidden = false;
    bar.classList.toggle('met', total >= min);
    fill.style.width = `${pct}%`;
    text.textContent = total >= min
      ? 'Minimum contribution reached — thank you!'
      : `${money(min - total)} more to reach the ${money(min)} minimum.`;

    // Mobile sticky bar
    const mobileBar = $('mobile-bar');
    mobileBar.hidden = count === 0 && total === 0;
    $('mobile-bar-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
    $('mobile-bar-total').textContent = money(total);

    // Disable pay until minimum met
    $('pay-btn').disabled = total < min;
  }

  // ---------- Custom amount ----------
  const amtInput = $('custom-amount');
  document.querySelectorAll('.amt-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.amt-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      amtInput.value = chip.dataset.amount;
      updateGrandTotal();
    });
  });
  amtInput.addEventListener('input', () => {
    document.querySelectorAll('.amt-chip').forEach(c => {
      c.classList.toggle('active', c.dataset.amount === amtInput.value);
    });
    updateGrandTotal();
  });

  // ---------- Clear basket ----------
  $('clear-cart').addEventListener('click', () => {
    if (!cartCount()) return;
    cart = {};
    renderCart();
    showToast('Basket cleared');
  });

  // ---------- Mobile bar ----------
  $('mobile-bar-btn').addEventListener('click', () => {
    $('cart-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---------- Token gate ----------
  async function init() {
    const token = window.__inviteToken
      || (new URLSearchParams(location.search).get('invite') || '').toUpperCase().trim();

    if (!token) {
      $('registry-loading').hidden = true;
      $('registry-locked').hidden = false;
      return;
    }

    try {
      const res = await fetch(`${API}?action=registry&token=${encodeURIComponent(token)}`);
      const data = await res.json();
      $('registry-loading').hidden = true;
      if (data.valid) {
        $('gift-content').hidden = false;
        renderGiftGrid();
        renderCart();
      } else {
        $('registry-locked').hidden = false;
      }
    } catch {
      $('registry-loading').hidden = true;
      $('registry-locked').hidden = false;
    }
  }

  // ---------- Pay ----------
  $('pay-btn')?.addEventListener('click', async () => {
    const btn = $('pay-btn');
    const label = btn.querySelector('.pay-label');
    const err = $('gift-error');
    err.hidden = true;

    const email = $('gift-email').value.trim();
    const name = $('gift-name').value.trim();
    const phone = $('gift-phone').value.trim();
    const anon = $('gift-anon').checked;
    const note = $('gift-message').value.trim();
    const customAmount = Math.max(0, Number(amtInput.value || 0));

    if (!email) {
      err.textContent = 'Please enter your email for the receipt.';
      err.hidden = false;
      $('gift-email').focus();
      return;
    }

    const items = Object.entries(cart).map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return { name: item.name, qty, price: item.price };
    });

    const itemsTotal = items.reduce((s, i) => s + i.price * i.qty, 0);
    const total = itemsTotal + customAmount;

    if (total < GIFTS.minCustom) {
      err.textContent = `Minimum contribution is ${money(GIFTS.minCustom)}. Please add more items or enter a custom amount.`;
      err.hidden = false;
      return;
    }

    btn.disabled = true;
    label.textContent = 'Opening secure checkout…';

    try {
      const res = await fetch(API, {
        method: 'POST',
        body: JSON.stringify({
          action: 'init-gift',
          token: window.__inviteToken || new URLSearchParams(location.search).get('invite'),
          items, amount: total, email, name, phone, anonymous: anon, note,
        }),
      });
      const data = await res.json();

      if (!data.ok) {
        err.textContent = 'Could not start payment: ' + (data.error || 'unknown');
        err.hidden = false;
        btn.disabled = false;
        label.textContent = 'Pay with Paystack';
        return;
      }
      window.location.href = data.authorization_url;
    } catch (e) {
      err.textContent = 'Connection error. Please try again.';
      err.hidden = false;
      btn.disabled = false;
      label.textContent = 'Pay with Paystack';
    }
  });

  // ---------- Return from Paystack ----------
  window.addEventListener('load', async () => {
    const params = new URLSearchParams(location.search);
    const reference = params.get('reference') || params.get('trxref');
    if (reference) {
      showToast('Verifying your payment…');
      try {
        const r = await fetch(`${API}?action=verify-gift&reference=${reference}`);
        const d = await r.json();
        if (d.valid) showToast('Thank you! Your gift has been received.');
        else showToast('Payment could not be verified. Please contact the couple.');
      } catch {
        showToast('Verification failed. Please contact the couple.');
      }
      history.replaceState({}, '', location.pathname + location.hash);
    }
  });

  // ---------- Copy buttons ----------
  document.querySelectorAll('.copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const old = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = old;
          btn.classList.remove('copied');
        }, 1500);
      } catch {}
    });
  });

  setTimeout(init, 100);
</script>
