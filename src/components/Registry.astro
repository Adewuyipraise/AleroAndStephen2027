---
import { wedding } from '../data/wedding.js';
const { registry, gifts } = wedding;
const API = 'https://script.google.com/macros/s/AKfycbwOrvTMUoC_GMJRBTjije-8qd1TqiHd0NgcQuHTx_UVRKyA_dk0S1LKR9gr_ByZCC6w/exec';
const quickAmounts = [10000, 25000, 50000, 100000];
---
<section id="registry" class="section">
  <div class="container registry-container">
    <p class="section-label">With love</p>
    <h2 class="section-title">Registry</h2>
    <p class="muted intro">
      Your presence is the greatest gift. If your heart moves you to give,
      pick something from our registry below, or send directly to our
      accounts.
    </p>

    <div id="registry-loading" class="state">
      <p class="muted">Verifying your invitation…</p>
    </div>

    <div id="registry-locked" class="state" hidden>
      <h3 class="serif">Gift details are for invited guests.</h3>
      <p class="muted">
        Please use the personalised link sent to you by the couple or the
        event planner to view this section.
      </p>
    </div>

    <div id="gift-content" hidden>
      <div class="shop">
        <!-- ================= GIFTS ================= -->
        <div class="gifts-col">
          <div class="col-head">
            <p class="block-kicker">Step 1</p>
            <h3 class="serif block-title">Choose a gift</h3>
            <p class="muted cart-intro">
              Tap any item to add it to your basket, then adjust the quantity
              as you like.
            </p>
          </div>
          <div class="gift-grid" id="gift-grid"></div>
        </div>

        <!-- ================= DETAILS ================= -->
        <div class="details-col">
          <div class="col-head">
            <p class="block-kicker">Step 2</p>
            <h3 class="serif block-title">Your details</h3>
          </div>

          <div class="form-grid">
            <label>Your name
              <input type="text" id="gift-name" placeholder="Jane Doe" />
            </label>
            <label>Email (for receipt)
              <input type="email" id="gift-email" placeholder="you@example.com" required />
            </label>
            <label>Phone (WhatsApp, optional)
              <input type="tel" id="gift-phone" placeholder="+234..." />
            </label>
            <label class="anon-label">
              <input type="checkbox" id="gift-anon" />
              <span>Send anonymously</span>
            </label>
          </div>

          <label class="full-width">
            Message for the couple (optional)
            <textarea id="gift-message" rows="2" placeholder="A little note…"></textarea>
          </label>
        </div>

        <!-- ================= BASKET ================= -->
        <aside class="basket" id="cart-panel">
          <div class="cart-header">
            <h4 class="cart-title">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              Your basket
            </h4>
            <span class="cart-count" id="cart-count">0 items</span>
          </div>

          <button type="button" class="clear-cart" id="clear-cart" hidden>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
            </svg>
            Clear basket
          </button>

          <div id="cart-empty" class="cart-empty">
            <div class="empty-icon" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </div>
            <p class="empty-title">Your basket is empty</p>
            <p class="empty-sub">Add a gift above, or send a custom amount below.</p>
          </div>

          <ul id="cart-items" class="cart-items"></ul>

          <div class="cart-total" id="cart-total-wrap" hidden>
            <span>Subtotal</span>
            <strong id="cart-total">₦0</strong>
          </div>

          <div class="custom-amount-wrap">
            <p class="block-kicker or-line"><span>Or contribute an amount</span></p>
            <div class="amt-chips">
              {quickAmounts.map((a) => (
                <button type="button" class="amt-chip" data-amount={a}>
                  ₦{a.toLocaleString()}
                </button>
              ))}
            </div>
            <div class="amount-field">
              <span class="amount-prefix" aria-hidden="true">₦</span>
              <input type="number" id="custom-amount" min="10000" step="1000" placeholder="e.g. 50000" aria-label="Custom amount in Naira" />
            </div>
          </div>

          <div class="min-progress" id="min-progress" hidden>
            <div class="min-progress-track" aria-hidden="true">
              <span class="min-progress-fill" id="min-progress-fill"></span>
            </div>
            <p class="min-progress-text" id="min-progress-text"></p>
          </div>

          <div class="checkout-total">
            <span>Total to pay</span>
            <strong id="grand-total">₦0</strong>
          </div>

          <button class="btn pay-btn" id="pay-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="1" y="4" width="22" height="16" rx="2"/>
              <line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            <span class="pay-label">Pay with Paystack</span>
          </button>
          <p class="cart-note muted">{gifts.note}</p>
          <p class="error" id="gift-error" hidden></p>
        </aside>
      </div>

      <!-- ================= BANK TRANSFER FALLBACK ================= -->
      <div class="direct">
        <div class="col-head">
          <p class="block-kicker">Prefer a transfer?</p>
          <h3 class="serif block-title">Or send directly</h3>
        </div>

        <p class="bank-label">Naira transfers</p>
        <div class="cards">
          {registry.naira.map(acc => (
            <div class="card">
              <p class="bank">{acc.bank}</p>
              <p class="holder">{acc.holder}</p>
              <p class="num">{acc.number}</p>
              <button class="copy" data-copy={acc.number}>Copy number</button>
            </div>
          ))}
        </div>

        <p class="bank-label">GBP — UK transfers</p>
        <div class="cards">
          <div class="card">
            <p class="bank">Lloyds Bank</p>
            <p class="holder">{registry.gbp.uk.name}</p>
            <p class="num">Sort code: {registry.gbp.uk.sortCode}</p>
            <p class="num">Account: {registry.gbp.uk.account}</p>
            <button class="copy" data-copy={`${registry.gbp.uk.sortCode} ${registry.gbp.uk.account}`}>Copy details</button>
          </div>
        </div>

        <p class="bank-label">International transfers</p>
        <div class="cards">
          <div class="card wide">
            <p class="holder">{registry.gbp.international.name}</p>
            <p class="num">IBAN: {registry.gbp.international.iban}</p>
            <p class="num">BIC/SWIFT: {registry.gbp.international.bic}</p>
            <button class="copy" data-copy={registry.gbp.international.iban}>Copy IBAN</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile sticky checkout bar -->
<div class="mobile-bar" id="mobile-bar" hidden>
  <div class="mobile-bar-info">
    <span class="mobile-bar-count" id="mobile-bar-count">0 items</span>
    <strong class="mobile-bar-total" id="mobile-bar-total">₦0</strong>
  </div>
  <button type="button" class="mobile-bar-btn" id="mobile-bar-btn">Review basket</button>
</div>

<!-- Toast -->
<div id="toast" class="toast" role="status" aria-live="polite"></div>

<style>
  /* `.container` override — this section needs more room for the grid */
  .registry-container { max-width: 1160px; }

  .state { max-width: 720px; }
  .intro { max-width: 620px; margin: 0 0 44px; }

  /* Components below set explicit `display`, so `hidden` needs reinforcing */
  [hidden] { display: none !important; }

  .block-kicker {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 10.5px;
    color: var(--gold);
    margin: 0 0 8px;
    font-weight: 500;
  }
  .block-title { font-size: clamp(24px, 3vw, 30px); margin: 0 0 8px; font-weight: 400; }
  .col-head { margin-bottom: 24px; }
  .cart-intro { max-width: 480px; margin: 0; font-size: 15px; }

  /* ---------------- Layout ---------------- */
  .shop {
    display: grid;
    grid-template-areas: "gifts" "details" "basket";
    gap: 40px;
    align-items: start;
  }
  .gifts-col { grid-area: gifts; }
  .details-col { grid-area: details; }
  .basket { grid-area: basket; }

  @media (min-width: 960px) {
    .shop {
      grid-template-areas: "gifts basket" "details basket";
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: 32px 40px;
    }
  }

  /* ---------------- Gift grid ---------------- */

  /* ---------------- Details form ---------------- */
  .details-col {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px;
  }
  .details-col .col-head { margin-bottom: 20px; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .form-grid label,
  .full-width {
    display: flex; flex-direction: column; gap: 7px;
    font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--muted);
  }
  .form-grid input,
  .full-width textarea {
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 15px;
    font-family: inherit;
    background: #fff;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-grid input:focus,
  .full-width textarea:focus,
  .amount-field:focus-within {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(168, 146, 116, 0.16);
  }
  .full-width { margin-bottom: 0; }
  .full-width textarea { resize: vertical; }

  .anon-label {
    flex-direction: row !important;
    align-items: center;
    gap: 10px !important;
    text-transform: none;
    letter-spacing: normal;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
    align-self: end;
    padding-bottom: 12px;
  }
  .anon-label input {
    width: 17px; height: 17px;
    accent-color: var(--gold);
    cursor: pointer;
  }

  /* ---------------- Basket ---------------- */
  .basket {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 24px;
    box-shadow: 0 24px 60px -40px rgba(30, 30, 28, 0.5);
  }
  @media (min-width: 960px) {
    .basket {
      position: sticky;
      top: 24px;
      align-self: start;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
    .basket::-webkit-scrollbar { width: 6px; }
    .basket::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
    .basket::-webkit-scrollbar-track { background: transparent; }
  }

  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line);
  }
  .cart-title {
    display: flex; align-items: center; gap: 9px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 21px;
    margin: 0;
    font-style: italic;
    color: var(--ink);
  }
  .cart-title svg { color: var(--gold); }
  .cart-count {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 13px;
    white-space: nowrap;
    transition: transform 0.25s ease, background 0.25s, color 0.25s;
  }
  .cart-count.pulse {
    transform: scale(1.09);
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }

  .cart-empty {
    text-align: center;
    padding: 26px 10px 22px;
  }
  .empty-icon {
    width: 68px; height: 68px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px dashed var(--line);
    display: flex; align-items: center; justify-content: center;
    color: var(--gold);
  }
  .empty-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    margin: 0 0 5px;
  }
  .empty-sub { font-size: 13.5px; color: var(--muted); margin: 0; line-height: 1.5; }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cart-total strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 21px;
    color: var(--ink);
    letter-spacing: 0;
    text-transform: none;
  }

  /* Custom amount */
  .custom-amount-wrap {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    margin-bottom: 18px;
  }
  .or-line {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 14px;
    white-space: nowrap;
  }
  .or-line::before, .or-line::after {
    content: ''; height: 1px; background: var(--line); flex: 1;
  }
  .amt-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .amt-chip {
    font-family: inherit;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: background 0.18s, color 0.18s, border-color 0.18s, transform 0.18s;
  }
  .amt-chip:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-1px); }
  .amt-chip.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }

  .amount-field {
    display: flex; align-items: center;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .amount-prefix {
    padding: 0 4px 0 15px;
    color: var(--muted);
    font-size: 15px;
  }
  .amount-field input {
    flex: 1;
    min-width: 0;
    border: none;
    padding: 13px 14px 13px 6px;
    font-size: 15px;
    font-family: inherit;
    background: transparent;
    color: var(--ink);
  }
  .amount-field input:focus { outline: none; box-shadow: none; }
  .amount-field input::-webkit-outer-spin-button,
  .amount-field input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .amount-field input[type=number] { -moz-appearance: textfield; appearance: textfield; }

  .checkout-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    background: linear-gradient(135deg, #fdfaf3 0%, #f7f0e3 100%);
    border: 1px solid #eadfc9;
    border-radius: 16px;
    margin-bottom: 16px;
  }
  .checkout-total span {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 10.5px;
    color: var(--muted);
  }
  .checkout-total strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    font-weight: 500;
  }

  .pay-btn {
    width: 100%;
    padding: 17px 24px;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #b9a37e 0%, var(--gold) 55%, #96805f 100%);
    color: #fff;
    letter-spacing: 0.14em;
    box-shadow: 0 14px 30px -14px rgba(168, 146, 116, 0.9);
    transition: transform 0.2s, box-shadow 0.2s, filter 0.2s;
  }
  .pay-btn:hover {
    background: linear-gradient(135deg, #c4af8c 0%, #b09a7b 55%, #9f8867 100%);
    color: #fff;
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 20px 34px -14px rgba(168, 146, 116, 0.95);
  }
  .pay-btn:active { transform: translateY(0); }
  .pay-btn:disabled,
  .pay-btn:disabled:hover {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
    background: linear-gradient(135deg, #b9a37e 0%, var(--gold) 55%, #96805f 100%);
    filter: none;
  }

  .cart-note { font-size: 12.5px; margin: 13px 0 0; line-height: 1.5; text-align: center; }
  .error { color: #b3261e; font-size: 14px; margin-top: 10px; text-align: center; }

  /* ---------------- Clear basket ---------------- */
  .clear-cart {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-end;
    margin: -4px 0 8px;
    background: none;
    border: none;
    padding: 4px 2px;
    font-family: inherit;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .clear-cart:hover { color: #b3261e; }

  /* ---------------- Minimum contribution progress ---------------- */
  .min-progress { margin: 16px 0 0; }
  .min-progress-track {
    height: 4px;
    border-radius: 999px;
    background: #ece5d6;
    overflow: hidden;
  }
  .min-progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, #d8c79e, var(--gold));
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .min-progress.met .min-progress-fill { background: var(--green); }
  .min-progress-text {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
    text-align: center;
  }
  .min-progress.met .min-progress-text { color: var(--green); }

  /* ---------------- Mobile sticky bar ---------------- */
  .mobile-bar {
    position: fixed;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 12px 12px 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 20px 50px -18px rgba(30, 30, 28, 0.4);
    z-index: 900;
    transform: translateY(0);
    animation: bar-in 0.3s ease;
  }
  @keyframes bar-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mobile-bar-info { display: flex; flex-direction: column; gap: 2px; }
  .mobile-bar-count {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mobile-bar-total {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .mobile-bar-btn {
    flex-shrink: 0;
    background: var(--ink);
    color: var(--cream);
    border: none;
    border-radius: 999px;
    padding: 12px 22px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }
  .mobile-bar-btn:hover { background: #333330; }
  .mobile-bar-btn:active { transform: scale(0.97); }
  @media (min-width: 960px) { .mobile-bar { display: none !important; } }

  /* ---------------- Direct transfer ---------------- */
  .direct { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--line); }
  .bank-label {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 11px;
    color: var(--muted);
    margin: 34px 0 14px;
  }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: #e8dfcd;
    box-shadow: 0 20px 40px -28px rgba(30, 30, 28, 0.6);
  }
  .card.wide { grid-column: 1 / -1; }
  .bank {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 10.5px;
    color: var(--gold);
    margin: 0 0 10px;
  }
  .holder {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .num {
    font-size: 15px;
    margin: 0 0 6px;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .copy {
    margin-top: 14px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .copy:hover { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .copy.copied { background: var(--green); border-color: var(--green); color: #fff; }

  /* ---------------- Toast ---------------- */
  .toast {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(24px);
    background: var(--ink);
