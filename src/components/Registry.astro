---
import { wedding } from '../data/wedding.js';
const { registry, gifts } = wedding;
const API = 'https://script.google.com/macros/s/AKfycbwOrvTMUoC_GMJRBTjije-8qd1TqiHd0NgcQuHTx_UVRKyA_dk0S1LKR9gr_ByZCC6w/exec';
---
<section id="registry" class="section">
  <div class="container">
    <p class="section-label">With love</p>
    <h2 class="section-title">Registry</h2>
    <p class="muted intro">
      Your presence is the greatest gift. If your heart moves you to give,
      pick something from our registry below, or send directly to our
      accounts.
    </p>

    <div id="registry-loading" class="state">
      <p class="muted">Verifying your invitation…</p>
    </div>

    <div id="registry-locked" class="state" hidden>
      <h3 class="serif">Gift details are for invited guests.</h3>
      <p class="muted">
        Please use the personalised link sent to you by the couple or the
        event planner to view this section.
      </p>
    </div>

    <div id="gift-content" hidden>

      <!-- ================= GIFT REGISTRY ================= -->
      <div class="gift-cart-section">
        <h3 class="serif group-title">Gift Registry</h3>
        <p class="muted cart-intro">
          Tap any item to add it to your basket. Adjust quantities as you like.
          You can also send a custom amount below.
        </p>

        <div class="gift-grid" id="gift-grid"></div>
      </div>

      <!-- ================= BASKET ================= -->
      <div class="cart-panel" id="cart-panel">
        <div class="cart-header">
          <h4 class="cart-title">Your basket</h4>
          <span class="cart-count" id="cart-count">0 items</span>
        </div>

        <div id="cart-empty" class="cart-empty">
          <div class="empty-icon" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <p class="empty-title">Your basket is empty</p>
          <p class="empty-sub">Add a gift above, or send a custom amount below.</p>
        </div>

        <ul id="cart-items" class="cart-items"></ul>

        <div class="cart-total" id="cart-total-wrap" hidden>
          <span>Subtotal</span>
          <strong id="cart-total">₦0</strong>
        </div>

        <div class="custom-amount-wrap">
          <label class="cart-label">
            <span>Or send a custom amount (₦)</span>
            <input type="number" id="custom-amount" min="10000" step="1000" placeholder="e.g. 50000" />
          </label>
        </div>

        <div class="form-grid">
          <label>Your name
            <input type="text" id="gift-name" placeholder="Jane Doe" />
          </label>
          <label>Email (for receipt)
            <input type="email" id="gift-email" placeholder="you@example.com" required />
          </label>
          <label>Phone (WhatsApp, optional)
            <input type="tel" id="gift-phone" placeholder="+234..." />
          </label>
          <label class="anon-label">
            <input type="checkbox" id="gift-anon" />
            <span>Send anonymously</span>
          </label>
        </div>

        <label class="full-width">
          Message for the couple (optional)
          <textarea id="gift-message" rows="2" placeholder="A little note…"></textarea>
        </label>

        <div class="checkout-total">
          <span>Total to pay</span>
          <strong id="grand-total">₦0</strong>
        </div>

        <button class="btn pay-btn" id="pay-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:8px;">
            <rect x="1" y="4" width="22" height="16" rx="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
          Pay with Paystack
        </button>
        <p class="cart-note muted">{gifts.note}</p>
        <p class="error" id="gift-error" hidden></p>
      </div>

      <!-- ================= BANK TRANSFER FALLBACK ================= -->
      <h3 class="serif group-title">Or send directly</h3>

      <h4 class="serif sub-title">Naira transfers</h4>
      <div class="cards">
        {registry.naira.map(acc => (
          <div class="card">
            <p class="bank">{acc.bank}</p>
            <p class="holder">{acc.holder}</p>
            <p class="num">{acc.number}</p>
            <button class="copy" data-copy={acc.number}>Copy number</button>
          </div>
        ))}
      </div>

      <h4 class="serif sub-title">GBP — UK transfers</h4>
      <div class="cards">
        <div class="card">
          <p class="bank">Lloyds Bank</p>
          <p class="holder">{registry.gbp.uk.name}</p>
          <p class="num">Sort code: {registry.gbp.uk.sortCode}</p>
          <p class="num">Account: {registry.gbp.uk.account}</p>
          <button class="copy" data-copy={`${registry.gbp.uk.sortCode} ${registry.gbp.uk.account}`}>Copy details</button>
        </div>
      </div>

      <h4 class="serif sub-title">International transfers</h4>
      <div class="cards">
        <div class="card wide">
          <p class="holder">{registry.gbp.international.name}</p>
          <p class="num">IBAN: {registry.gbp.international.iban}</p>
          <p class="num">BIC/SWIFT: {registry.gbp.international.bic}</p>
          <button class="copy" data-copy={registry.gbp.international.iban}>Copy IBAN</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Toast -->
<div id="toast" class="toast" role="status" aria-live="polite"></div>

<style>
  .state { max-width: 720px; }
  .intro { max-width: 620px; margin: 0 0 40px; }
  .group-title { font-size: 26px; margin: 40px 0 16px; font-style: italic; }
  .sub-title { font-size: 20px; margin: 32px 0 12px; font-style: italic; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .card { background: #fff; border: 1px solid var(--line); padding: 24px; }
  .card.wide { grid-column: 1 / -1; }
  .bank { text-transform: uppercase; letter-spacing: 0.2em; font-size: 11px; color: var(--gold); margin: 0 0 8px; }
  .holder { font-family: 'Cormorant Garamond', serif; font-size: 20px; margin: 0 0 8px; }
  .num { font-size: 15px; margin: 0 0 6px; letter-spacing: 0.03em; }
  .copy {
    margin-top: 12px; background: none; border: 1px solid var(--line);
    padding: 8px 14px; font-size: 12px; letter-spacing: 0.1em;
    text-transform: uppercase; cursor: pointer;
  }
  .copy:hover { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  /* ---------------- Gift grid ---------------- */
  .gift-cart-section { margin-bottom: 48px; }
  .cart-intro { max-width: 620px; margin: 0 0 24px; }

  .gift-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 18px;
  }

  .gift-card {
    background: #fff;
    border: 1px solid var(--line);
    padding: 22px 20px 18px;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.18s ease, box-shadow 0.25s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .gift-card:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.07);
  }
  .gift-card:active { transform: translateY(-1px) scale(0.99); }
  .gift-card.in-cart { border-color: var(--gold); background: #fdfaf3; }

  .gift-emoji {
    font-size: 32px;
    margin: 0 0 10px;
    line-height: 1;
    transition: transform 0.25s ease;
  }
  .gift-card:hover .gift-emoji { transform: scale(1.12) rotate(-4deg); }

  .gift-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    margin: 0 0 4px;
    line-height: 1.25;
  }
  .gift-price {
    font-size: 15px;
    color: var(--gold);
    margin: 0 0 16px;
    font-weight: 500;
  }

  .gift-add-btn {
    margin-top: auto;
    background: #fff;
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 10px 16px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .gift-add-btn:hover {
    background: var(--ink);
    color: #fff;
  }
  .gift-card.in-cart .gift-add-btn {
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
  .gift-card.in-cart .gift-add-btn:hover {
    background: #8f7a5c;
    border-color: #8f7a5c;
  }

  /* Quantity badge on selected cards */
  .gift-qty-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--gold);
    color: #fff;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(168, 146, 116, 0.35);
    animation: popIn 0.25s ease;
  }
  @keyframes popIn {
    0% { transform: scale(0.4); opacity: 0; }
    60% { transform: scale(1.15); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ---------------- Cart panel ---------------- */
  .cart-panel {
    background: #fff;
    border: 1px solid var(--line);
    padding: 28px;
    margin-top: 32px;
  }
  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .cart-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 24px;
    margin: 0;
    font-style: italic;
  }
  .cart-count {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cart-empty {
    text-align: center;
    padding: 24px 16px 32px;
  }
  .empty-icon {
    color: var(--line);
    margin: 0 0 12px;
  }
  .empty-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    margin: 0 0 4px;
  }
  .empty-sub { font-size: 14px; color: var(--muted); margin: 0; }

  .cart-items { list-style: none; padding: 0; margin: 0 0 16px; }
  .cart-items li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    animation: slideIn 0.28s ease;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .cart-items li:last-child { border-bottom: none; }

  .cart-item-info { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .cart-item-name { font-weight: 500; }
  .cart-item-line-price { color: var(--muted); font-size: 13px; }

  .qty-controls { display: flex; gap: 8px; align-items: center; }
  .qty-btn {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    font-family: inherit;
    color: var(--ink);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .qty-btn:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .qty-btn:active { transform: scale(0.94); }
  .qty-value { min-width: 18px; text-align: center; font-weight: 500; }

  .cart-total {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 2px solid var(--line);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    margin-bottom: 16px;
  }

  .custom-amount-wrap { margin: 0 0 20px; }
  .cart-label {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 13px; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--muted);
  }
  .custom-amount-wrap input,
  .form-grid input[type="text"],
  .form-grid input[type="email"],
  .form-grid input[type="tel"] {
    padding: 12px 14px;
    border: 1px solid var(--line);
    font-size: 15px;
    font-family: inherit;
    background: #fff;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .form-grid label {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 13px; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--muted);
  }
  .anon-label {
    flex-direction: row !important;
    align-items: center;
    gap: 8px !important;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
    cursor: pointer;
  }
  .anon-label input { cursor: pointer; }

  .full-width {
    display: flex; flex-direction: column; gap: 6px;
    font-size: 13px; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--muted);
    margin-bottom: 20px;
  }
  .full-width textarea {
    padding: 12px 14px;
    border: 1px solid var(--line);
    font-size: 15px;
    font-family: inherit;
    resize: vertical;
  }

  .checkout-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 20px;
    background: #fdfaf3;
    border: 1px solid var(--gold);
    margin-bottom: 16px;
  }
  .checkout-total span {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 11px;
    color: var(--muted);
  }
  .checkout-total strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 26px;
    color: var(--ink);
  }

  .pay-btn {
    width: 100%;
    padding: 18px 28px;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pay-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .cart-note { font-size: 13px; margin: 12px 0 0; }
  .error { color: #b3261e; font-size: 14px; margin-top: 8px; }

  /* ---------------- Toast ---------------- */
  .toast {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(24px);
    background: var(--ink);
    color: #fff;
    padding: 14px 24px;
    border-radius: 4px;
    font-size: 14px;
    letter-spacing: 0.02em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease, transform 0.28s ease;
    z-index: 999;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 560px) {
    .form-grid { grid-template-columns: 1fr; }
    .cart-panel { padding: 20px; }
    .gift-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .gift-card { padding: 16px 14px 14px; }
    .gift-emoji { font-size: 26px; }
    .gift-name { font-size: 17px; }
    .toast { bottom: 16px; padding: 12px 18px; font-size: 13px; left: 16px; right: 16px; transform: translateY(24px); }
    .toast.show { transform: translateY(0); }
  }
</style>

<script define:vars={{ API, GIFTS :gifts }}>
  const $ = (id) => document.getElementById(id);
  let cart = {}; // { itemId: qty }

  // ---------- Toast ----------
  let toastTimer;
  function showToast(msg) {
    const t = $('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
  }

  // ---------- Gift grid ----------
  function renderGiftGrid() {
    const grid = $('gift-grid');
    grid.innerHTML = GIFTS.items.map(item => `
      <div class="gift-card" data-id="${item.id}" role="button" tabindex="0" aria-label="Add ${item.name} to basket">
        <div class="gift-emoji" aria-hidden="true">${item.emoji || '🎁'}</div>
        <p class="gift-name">${item.name}</p>
        <p class="gift-price">₦${item.price.toLocaleString()}</p>
        <button type="button" class="gift-add-btn" data-id="${item.id}">
          Add to basket
        </button>
      </div>
    `).join('');

    // Whole card click
    grid.querySelectorAll('.gift-card').forEach(card => {
      card.addEventListener('click', (e) => {
        // ignore if clicking button (handled separately)
        if (e.target.closest('.gift-add-btn')) return;
        addItem(card.dataset.id);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          addItem(card.dataset.id);
        }
      });
    });

    // Add button click
    grid.querySelectorAll('.gift-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        addItem(btn.dataset.id);
      });
    });
  }

  function addItem(id) {
    cart[id] = (cart[id] || 0) + 1;
    const item = GIFTS.items.find(i => i.id === id);
    showToast(`Added ${item.name} to basket`);
    renderCart();

    // Subtle bump animation
    const card = document.querySelector(`.gift-card[data-id="${id}"]`);
    if (card) {
      card.animate(
        [
          { transform: 'translateY(-3px) scale(1)' },
          { transform: 'translateY(-6px) scale(1.02)' },
          { transform: 'translateY(-3px) scale(1)' },
        ],
        { duration: 320, easing: 'ease-out' }
      );
    }
  }

  // ---------- Cart render ----------
  function renderCart() {
    const list = $('cart-items');
    const empty = $('cart-empty');
    const totalWrap = $('cart-total-wrap');
    const count = $('cart-count');

    const entries = Object.entries(cart);
    const itemCount = entries.reduce((sum, [, q]) => sum + q, 0);

    count.textContent = itemCount === 1 ? '1 item' : `${itemCount} items`;

    if (entries.length === 0) {
      empty.hidden = false;
      list.innerHTML = '';
      totalWrap.hidden = true;
      document.querySelectorAll('.gift-card').forEach(c => {
        c.classList.remove('in-cart');
        c.querySelector('.gift-qty-badge')?.remove();
      });
      updateGrandTotal();
      return;
    }

    empty.hidden = true;
    totalWrap.hidden = false;

    let subtotal = 0;
    list.innerHTML = entries.map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      if (!item) return '';
      const line = item.price * qty;
      subtotal += line;
      return `
        <li data-id="${id}">
          <div class="cart-item-info">
            <span class="cart-item-name">${item.emoji || '🎁'} ${item.name}</span>
            <span class="cart-item-line-price">₦${item.price.toLocaleString()} × ${qty} = ₦${line.toLocaleString()}</span>
          </div>
          <div class="qty-controls">
            <button type="button" class="qty-btn" data-act="dec" data-id="${id}" aria-label="Decrease">−</button>
            <span class="qty-value">${qty}</span>
            <button type="button" class="qty-btn" data-act="inc" data-id="${id}" aria-label="Increase">+</button>
          </div>
        </li>
      `;
    }).join('');

    $('cart-total').textContent = `₦${subtotal.toLocaleString()}`;

    // Sync card selected state + quantity badges
    document.querySelectorAll('.gift-card').forEach(card => {
      const id = card.dataset.id;
      const qty = cart[id];
      card.classList.toggle('in-cart', !!qty);

      let badge = card.querySelector('.gift-qty-badge');
      if (qty) {
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'gift-qty-badge';
          card.appendChild(badge);
        }
        badge.textContent = qty;
        // Change button label
        const btn = card.querySelector('.gift-add-btn');
        if (btn) btn.textContent = 'Add another';
      } else {
        badge?.remove();
        const btn = card.querySelector('.gift-add-btn');
        if (btn) btn.textContent = 'Add to basket';
      }
    });

    // Bind qty buttons
    list.querySelectorAll('.qty-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.id;
        const act = btn.dataset.act;
        if (act === 'inc') cart[id] += 1;
        else {
          cart[id] -= 1;
          if (cart[id] <= 0) {
            delete cart[id];
            const item = GIFTS.items.find(i => i.id === id);
            showToast(`Removed ${item.name}`);
          }
        }
        renderCart();
      });
    });

    updateGrandTotal();
  }

  function updateGrandTotal() {
    const itemsTotal = Object.entries(cart).reduce((sum, [id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return sum + (item ? item.price * qty : 0);
    }, 0);
    const custom = Math.max(0, Number($('custom-amount').value || 0));
    $('grand-total').textContent = `₦${(itemsTotal + custom).toLocaleString()}`;
  }

  $('custom-amount')?.addEventListener('input', updateGrandTotal);

  // ---------- Token gate ----------
  async function init() {
    const token = window.__inviteToken
      || (new URLSearchParams(location.search).get('invite') || '').toUpperCase().trim();

    if (!token) {
      $('registry-loading').hidden = true;
      $('registry-locked').hidden = false;
      return;
    }

    try {
      const res = await fetch(`${API}?action=registry&token=${encodeURIComponent(token)}`);
      const data = await res.json();
      $('registry-loading').hidden = true;
      if (data.valid) {
        $('gift-content').hidden = false;
        renderGiftGrid();
        renderCart();
      } else {
        $('registry-locked').hidden = false;
      }
    } catch {
      $('registry-loading').hidden = true;
      $('registry-locked').hidden = false;
    }
  }

  // ---------- Pay ----------
  $('pay-btn')?.addEventListener('click', async () => {
    const btn = $('pay-btn');
    const err = $('gift-error');
    err.hidden = true;

    const email = $('gift-email').value.trim();
    const name = $('gift-name').value.trim();
    const phone = $('gift-phone').value.trim();
    const anon = $('gift-anon').checked;
    const note = $('gift-message').value.trim();
    const customAmount = Math.max(0, Number($('custom-amount').value || 0));

    if (!email) {
      err.textContent = 'Please enter your email for the receipt.';
      err.hidden = false;
      $('gift-email').focus();
      return;
    }

    const items = Object.entries(cart).map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return { name: item.name, qty, price: item.price };
    });

    const itemsTotal = items.reduce((s, i) => s + i.price * i.qty, 0);
    const total = itemsTotal + customAmount;

    if (total < GIFTS.minCustom) {
      err.textContent = `Minimum contribution is ₦${GIFTS.minCustom.toLocaleString()}. Please add more items or enter a custom amount.`;
      err.hidden = false;
      return;
    }

    btn.disabled = true;
    btn.innerHTML = 'Opening secure checkout…';

    try {
      const res = await fetch(API, {
        method: 'POST',
        body: JSON.stringify({
          action: 'init-gift',
          token: window.__inviteToken || new URLSearchParams(location.search).get('invite'),
          items, amount: total, email, name, phone, anonymous: anon, note,
        }),
      });
      const data = await res.json();

      if (!data.ok) {
        err.textContent = 'Could not start payment: ' + (data.error || 'unknown');
        err.hidden = false;
        btn.disabled = false;
        btn.innerHTML = 'Pay with Paystack';
        return;
      }
      window.location.href = data.authorization_url;
    } catch (e) {
      err.textContent = 'Connection error. Please try again.';
      err.hidden = false;
      btn.disabled = false;
      btn.innerHTML = 'Pay with Paystack';
    }
  });

  // ---------- Return from Paystack ----------
  window.addEventListener('load', async () => {
    const params = new URLSearchParams(location.search);
    const reference = params.get('reference') || params.get('trxref');
    if (reference) {
      showToast('Verifying your payment…');
      try {
        const r = await fetch(`${API}?action=verify-gift&reference=${reference}`);
        const d = await r.json();
        if (d.valid) showToast('Thank you! Your gift has been received.');
        else showToast('Payment could not be verified. Please contact the couple.');
      } catch {
        showToast('Verification failed. Please contact the couple.');
      }
      history.replaceState({}, '', location.pathname + location.hash);
    }
  });

  // ---------- Copy buttons ----------
  document.querySelectorAll('.copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const old = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = old), 1500);
      } catch {}
    });
  });

  setTimeout(init, 100);
</script>