---
import { wedding } from '../data/wedding.js';
import CollapsibleSection from './CollapsibleSection.astro';
const { registry, gifts } = wedding;
const API = 'https://script.google.com/macros/s/AKfycbwOrvTMUoC_GMJRBTjije-8qd1TqiHd0NgcQuHTx_UVRKYA_dk0S1LKR9gr_ByZCC6w/exec';
const quickAmounts = [10000, 25000, 50000, 100000];
---
<CollapsibleSection
  id="registry"
  label="With love"
  title="Registry"
  summaryTitle="Send a gift"
  summaryText="Browse our gift registry, contribute to our honeymoon fund, or send directly to our accounts. Every gift, big or small, means the world to us."
  buttonText="Open Registry"
  containerClass="container-wide"
>
  <div id="registry-loading" class="state">
    <p class="muted">Verifying your invitation…</p>
  </div>

  <div id="registry-locked" class="state" hidden>
    <h3 class="serif">Gift details are for invited guests.</h3>
    <p class="muted">
      Please use the personalised link sent to you by the couple or the
      event planner to view this section.
    </p>
  </div>

  <div id="gift-content" hidden>
    <div class="co-head">
      <p class="co-kicker">Step 1</p>
      <h3 class="serif co-title">Choose a gift</h3>
      <p class="muted co-intro">
        Tap any item to add it to your basket, then adjust the quantity as you like.
      </p>
    </div>

    <div class="co-grid" id="gift-grid"></div>

    <!-- BASKET (collapsible) -->
    <aside class="co-order" id="cart-panel">
      <button type="button" class="co-order-head" id="cart-toggle" aria-expanded="false">
        <span class="co-order-head-left">
          <span class="co-order-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </span>
          <span class="co-order-titles">
            <span class="co-order-title">Your basket</span>
            <span class="co-order-count" id="cart-count">0 items</span>
          </span>
        </span>
        <svg class="co-order-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>

      <div class="co-order-body" id="cart-body" hidden>
        <!-- LEFT: items + amount -->
        <div class="co-col">
          <button type="button" class="co-textbtn" id="clear-cart" hidden>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
            </svg>
            Clear basket
          </button>

          <div id="cart-empty" class="co-empty">
            <div class="ico" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </div>
            <p class="t">Your basket is empty</p>
            <p class="s">Add a gift above, or send a custom amount below.</p>
          </div>

          <ul id="cart-items" class="co-items"></ul>

          <div class="co-subtotal" id="cart-total-wrap" hidden>
            <span>Subtotal</span>
            <strong id="cart-total">₦0</strong>
          </div>

          <div class="co-divider"><span>Or contribute an amount</span></div>
          <div class="co-chips">
            {quickAmounts.map((a) => (
              <button type="button" class="co-chip" data-amount={a}>
                ₦{a.toLocaleString()}
              </button>
            ))}
          </div>
          <div class="co-amount">
            <span class="prefix" aria-hidden="true">₦</span>
            <input type="number" id="custom-amount" min="10000" step="1000" placeholder="e.g. 50000" aria-label="Custom amount in Naira" />
          </div>

          <div class="co-progress" id="min-progress" hidden>
            <div class="co-progress-track" aria-hidden="true">
              <span class="co-progress-fill" id="min-progress-fill"></span>
            </div>
            <p class="co-progress-text" id="min-progress-text"></p>
          </div>
        </div>

        <!-- RIGHT: details + checkout -->
        <div class="co-col">
          <p class="co-kicker">Step 2 — Your details</p>
          <div class="co-fields">
            <label class="co-field">Your name
              <input type="text" id="gift-name" placeholder="Jane Doe" />
            </label>
            <label class="co-field">Email (for receipt)
              <input type="email" id="gift-email" placeholder="you@example.com" required />
            </label>
            <label class="co-field">Phone (WhatsApp, optional)
              <input type="tel" id="gift-phone" placeholder="+234..." />
            </label>
            <label class="co-field check">
              <input type="checkbox" id="gift-anon" />
              <span>Send anonymously</span>
            </label>
            <label class="co-field wide">Message for the couple (optional)
              <textarea id="gift-message" rows="2" placeholder="A little note…"></textarea>
            </label>
          </div>

          <div class="co-total">
            <span>Total to pay</span>
            <strong id="grand-total">₦0</strong>
          </div>

          <button class="co-pay" id="pay-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="1" y="4" width="22" height="16" rx="2"/>
              <line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            <span class="pay-label">Checkout</span>
          </button>
          <p class="co-note">{gifts.note}</p>
          <p class="co-error" id="gift-error" hidden></p>
        </div>
      </div>
    </aside>

    <!-- BANK TRANSFER -->
    <div class="co-direct">
      <p class="co-kicker">Prefer a transfer?</p>
      <h3 class="serif co-title">Or send directly</h3>

      <p class="co-bank-label">Naira transfers</p>
      <div class="co-banks">
        {registry.naira.map(acc => (
          <div class="co-bank">
            <p class="bank">{acc.bank}</p>
            <p class="holder">{acc.holder}</p>
            <p class="num">{acc.number}</p>
            <button class="copy" data-copy={acc.number}>Copy number</button>
          </div>
        ))}
      </div>

      <p class="co-bank-label">GBP — UK transfers</p>
      <div class="co-banks">
        <div class="co-bank">
          <p class="bank">Lloyds Bank</p>
          <p class="holder">{registry.gbp.uk.name}</p>
          <p class="num">Sort code: {registry.gbp.uk.sortCode}</p>
          <p class="num">Account: {registry.gbp.uk.account}</p>
          <button class="copy" data-copy={`${registry.gbp.uk.sortCode} ${registry.gbp.uk.account}`}>Copy details</button>
        </div>
      </div>

      <p class="co-bank-label">International transfers</p>
      <div class="co-banks">
        <div class="co-bank wide">
          <p class="holder">{registry.gbp.international.name}</p>
          <p class="num">IBAN: {registry.gbp.international.iban}</p>
          <p class="num">BIC/SWIFT: {registry.gbp.international.bic}</p>
          <button class="copy" data-copy={registry.gbp.international.iban}>Copy IBAN</button>
        </div>
      </div>
    </div>
  </div>
</CollapsibleSection>

<!-- Mobile sticky checkout bar -->
<div class="co-mobilebar" id="mobile-bar" hidden>
  <div class="info">
    <span class="count" id="mobile-bar-count">0 items</span>
    <strong class="tot" id="mobile-bar-total">₦0</strong>
  </div>
  <button type="button" class="go" id="mobile-bar-btn">Review basket</button>
</div>

<!-- Toast -->
<div id="toast" class="co-toast" role="status" aria-live="polite"></div>

<style>
  .state { max-width: 720px; }
</style>

<script define:vars={{ API, GIFTS: gifts }}>
  const $ = (id) => document.getElementById(id);
  let cart = {};
  const money = (n) => `₦${Number(n).toLocaleString()}`;

  // Collapse state managed by CollapsibleSection — only basket logic here
  const cartToggle = $('cart-toggle');
  const cartBody = $('cart-body');
  cartToggle?.addEventListener('click', () => {
    const isOpen = !cartBody.hidden;
    cartBody.hidden = isOpen;
    cartToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  let toastTimer;
  function showToast(msg) {
    const t = $('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
  }
  function pulseCount() {
    const c = $('cart-count');
    c.classList.remove('pulse');
    void c.offsetWidth;
    c.classList.add('pulse');
    setTimeout(() => c.classList.remove('pulse'), 450);
  }

  function renderGiftGrid() {
    const grid = $('gift-grid');
    grid.innerHTML = GIFTS.items.map((item, i) => `
      <div class="co-card" data-id="${item.id}" style="--d:${i * 70}ms">
        <div class="co-media${item.image ? ' has-img' : ''}">
          ${item.image ? `<img src="${item.image}" alt="${item.name}" loading="lazy"
               onerror="this.closest('.co-media').classList.remove('has-img');this.remove();" />` : ''}
          <span class="co-media-fallback" aria-hidden="true">${item.emoji || '🎁'}</span>
          <span class="co-badge" aria-hidden="true">✓</span>
        </div>
        <div class="co-body">
          <p class="co-name">${item.name}</p>
          <p class="co-price">${money(item.price)}</p>
        </div>
        <div class="co-foot">
          <button type="button" class="co-add" data-add="${item.id}"
                  aria-label="Add ${item.name} to basket">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Add to basket
          </button>
          <div class="co-stepper">
            <button type="button" data-act="dec" aria-label="Decrease quantity of ${item.name}">−</button>
            <span class="qty" aria-live="polite">1</span>
            <button type="button" data-act="inc" aria-label="Increase quantity of ${item.name}">+</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function changeQty(id, delta) {
    const item = GIFTS.items.find(i => i.id === id);
    if (!item) return;
    const next = (cart[id] || 0) + delta;
    if (next <= 0) {
      if (cart[id]) { delete cart[id]; showToast(`Removed ${item.name}`); }
    } else {
      cart[id] = next;
    }
    renderCart();
  }

  function addItem(id) {
    const item = GIFTS.items.find(i => i.id === id);
    if (!item) return;
    cart[id] = (cart[id] || 0) + 1;
    showToast(`Added ${item.name} to basket`);
    renderCart();
    pulseCount();
    if (Object.keys(cart).length === 1 && cartBody.hidden) {
      cartBody.hidden = false;
      cartToggle.setAttribute('aria-expanded', 'true');
    }
  }

  $('gift-grid').addEventListener('click', (e) => {
    const step = e.target.closest('.co-stepper button');
    if (step) {
      e.stopPropagation();
      changeQty(step.closest('.co-card').dataset.id, step.dataset.act === 'inc' ? 1 : -1);
      return;
    }
    const card = e.target.closest('.co-card');
    if (card) addItem(card.dataset.id);
  });

  function renderCart() {
    const list = $('cart-items');
    const empty = $('cart-empty');
    const totalWrap = $('cart-total-wrap');
    const entries = Object.entries(cart);

    document.querySelectorAll('#gift-grid .co-card').forEach(card => {
      const qty = cart[card.dataset.id] || 0;
      card.classList.toggle('is-active', qty > 0);
      const stepperQty = card.querySelector('.co-stepper .qty');
      if (stepperQty) stepperQty.textContent = qty || 1;
    });

    if (entries.length === 0) {
      empty.hidden = false;
      list.innerHTML = '';
      totalWrap.hidden = true;
      updateGrandTotal();
      return;
    }

    empty.hidden = true;
    totalWrap.hidden = false;
    let subtotal = 0;

    list.innerHTML = entries.map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      if (!item) return '';
      const line = item.price * qty;
      subtotal += line;
      const thumb = item.image
        ? `<img src="${item.image}" alt="" loading="lazy" />`
        : `<span>${item.emoji || '🎁'}</span>`;
      return `
        <li data-id="${id}">
          <div class="co-thumb">${thumb}</div>
          <div class="co-item-info">
            <span class="co-item-name">${item.name}</span>
            <span class="co-item-sub">${money(item.price)} × ${qty} = ${money(line)}</span>
          </div>
          <div class="co-item-ctrl">
            <div class="co-qty">
              <button type="button" data-act="dec" aria-label="Decrease">−</button>
              <span class="v">${qty}</span>
              <button type="button" data-act="inc" aria-label="Increase">+</button>
            </div>
            <button type="button" class="co-remove" data-act="rm" aria-label="Remove ${item.name}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </li>
      `;
    }).join('');

    $('cart-total').textContent = money(subtotal);
    updateGrandTotal();
  }

  $('cart-items').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const id = btn.closest('li').dataset.id;
    const act = btn.dataset.act;
    if (act === 'rm') {
      const item = GIFTS.items.find(i => i.id === id);
      delete cart[id];
      if (item) showToast(`Removed ${item.name}`);
      renderCart();
      return;
    }
    changeQty(id, act === 'inc' ? 1 : -1);
  });

  function cartCount() {
    return Object.values(cart).reduce((sum, qty) => sum + qty, 0);
  }

  function grandTotalValue() {
    const itemsTotal = Object.entries(cart).reduce((sum, [id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return sum + (item ? item.price * qty : 0);
    }, 0);
    return itemsTotal + Math.max(0, Number($('custom-amount').value || 0));
  }

  function updateGrandTotal() {
    const total = grandTotalValue();
    const count = cartCount();
    $('grand-total').textContent = money(total);
    $('cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
    $('clear-cart').hidden = count === 0;

    const min = GIFTS.minCustom;
    const bar = $('min-progress');
    const fill = $('min-progress-fill');
    const text = $('min-progress-text');
    const pct = Math.min(100, Math.round((total / min) * 100));
    bar.hidden = false;
    bar.classList.toggle('met', total >= min);
    fill.style.width = `${pct}%`;
    text.textContent = total >= min
      ? 'Minimum contribution reached — thank you!'
      : `${money(min - total)} more to reach the ${money(min)} minimum.`;

    const mobileBar = $('mobile-bar');
    mobileBar.hidden = count === 0 && total === 0;
    $('mobile-bar-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
    $('mobile-bar-total').textContent = money(total);

    $('pay-btn').disabled = total < min;
  }

  const amtInput = $('custom-amount');
  document.querySelectorAll('.co-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.co-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      amtInput.value = chip.dataset.amount;
      updateGrandTotal();
    });
  });
  amtInput.addEventListener('input', () => {
    document.querySelectorAll('.co-chip').forEach(c => {
      c.classList.toggle('active', c.dataset.amount === amtInput.value);
    });
    updateGrandTotal();
  });

  $('clear-cart').addEventListener('click', () => {
    if (!cartCount()) return;
    cart = {};
    renderCart();
    showToast('Basket cleared');
  });

  $('mobile-bar-btn').addEventListener('click', () => {
    if (cartBody.hidden) {
      cartBody.hidden = false;
      cartToggle.setAttribute('aria-expanded', 'true');
    }
    $('cart-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Validate the invite token. Prefer the registry endpoint, fall back to the
  // shared `validate` endpoint (the same one RSVP uses). If the API cannot be
  // reached at all we do NOT lock the guest out — the personalised link is the
  // credential, and the gift data is already on the page.
  async function checkInvite(token) {
    const enc = encodeURIComponent(token);
    const endpoints = [
      `${API}?action=registry&token=${enc}`,
      `${API}?action=validate&token=${enc}`,
    ];
    let explicitlyInvalid = false;
    for (const url of endpoints) {
      try {
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) continue;
        const data = await res.json();
        if (data && (data.valid === true || data.reason === 'already_used')) return true;
        if (data && data.valid === false) explicitlyInvalid = true;
      } catch { /* network/CORS — try the next endpoint */ }
    }
    return explicitlyInvalid ? false : 'unreachable';
  }

  async function init() {
    const token = window.__inviteToken
      || (new URLSearchParams(location.search).get('invite') || '').toUpperCase().trim();

    if (!token) {
      $('registry-loading').hidden = true;
      $('registry-locked').hidden = false;
      return;
    }

    const verdict = await checkInvite(token);
    $('registry-loading').hidden = true;
    if (verdict === false) {
      $('registry-locked').hidden = false;
      return;
    }
    $('gift-content').hidden = false;
    renderGiftGrid();
    renderCart();
  }

  $('pay-btn')?.addEventListener('click', async () => {
    const btn = $('pay-btn');
    const label = btn.querySelector('.pay-label');
    const err = $('gift-error');
    err.hidden = true;

    const email = $('gift-email').value.trim();
    const name = $('gift-name').value.trim();
    const phone = $('gift-phone').value.trim();
    const anon = $('gift-anon').checked;
    const note = $('gift-message').value.trim();
    const customAmount = Math.max(0, Number(amtInput.value || 0));

    if (!email) {
      err.textContent = 'Please enter your email for the receipt.';
      err.hidden = false;
      $('gift-email').focus();
      return;
    }

    const items = Object.entries(cart).map(([id, qty]) => {
      const item = GIFTS.items.find(i => i.id === id);
      return { name: item.name, qty, price: item.price };
    });

    const itemsTotal = items.reduce((s, i) => s + i.price * i.qty, 0);
    const total = itemsTotal + customAmount;

    if (total < GIFTS.minCustom) {
      err.textContent = `Minimum contribution is ${money(GIFTS.minCustom)}.`;
      err.hidden = false;
      return;
    }

    btn.disabled = true;
    label.textContent = 'Opening secure checkout…';

    try {
      const res = await fetch(API, {
        method: 'POST',
        body: JSON.stringify({
          action: 'init-gift',
          token: window.__inviteToken || new URLSearchParams(location.search).get('invite'),
          items, amount: total, email, name, phone, anonymous: anon, note,
        }),
      });
      const data = await res.json();
      if (!data.ok) {
        err.textContent = 'Could not start payment: ' + (data.error || 'unknown');
        err.hidden = false;
        btn.disabled = false;
        label.textContent = 'Checkout';
        return;
      }
      window.location.href = data.authorization_url;
    } catch (e) {
      err.textContent = 'Connection error. Please try again.';
      err.hidden = false;
      btn.disabled = false;
      label.textContent = 'Checkout';
    }
  });

  window.addEventListener('load', async () => {
    const params = new URLSearchParams(location.search);
    const reference = params.get('reference') || params.get('trxref');
    if (reference) {
      showToast('Verifying your payment…');
      try {
        const r = await fetch(`${API}?action=verify-gift&reference=${reference}`);
        const d = await r.json();
        if (d.valid) showToast('Thank you! Your gift has been received.');
        else showToast('Payment could not be verified. Please contact the couple.');
      } catch {
        showToast('Verification failed. Please contact the couple.');
      }
      history.replaceState({}, '', location.pathname + location.hash);
    }
  });

  document.querySelectorAll('.copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const old = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = old;
          btn.classList.remove('copied');
        }, 1500);
      } catch {}
    });
  });

  setTimeout(init, 100);
</script>
